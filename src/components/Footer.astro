---
import { Image } from 'astro:assets';
import { logo } from '../config/artwork';
import { site } from '../config/site';
import { withBase } from '../lib/url';
import { whatsappUrl } from '../lib/whatsapp';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Image
        src={logo}
        alt={site.brand.name}
        width={210}
        loading="lazy"
        class="footer-logo"
      /><p class="footer-tagline">{site.brand.tagline}</p>
    </div>
    <div>
      <p class="footer-label">Ven a vernos</p><address>
        {site.contact.address}<br />{site.contact.postalAddress}
      </address><a
        href={site.contact.mapsUrl}
        target="_blank"
        rel="noopener noreferrer">Cómo llegar</a>
    </div>
    <nav aria-label="Contacto y redes">
      <p class="footer-label">Seguimos en contacto</p><ul role="list">
        <li>
          <a href={`tel:${site.contact.phone}`}>{site.contact.phoneLabel}</a>
        </li><li>
          <a href={whatsappUrl()!} target="_blank" rel="noopener noreferrer"
            >WhatsApp</a>
        </li><li>
          <a
            href={site.instagram.profileUrl}
            target="_blank"
            rel="noopener noreferrer">Instagram</a>
        </li><li><a href={withBase('/hola/')}>Todos nuestros enlaces</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.brand.name}</span><span
      >Tu zapatería en Castellón</span>
  </div>
</footer>
<style>
  .site-footer {
    padding-block: 3.5rem 1rem;
    border-top: 1px solid var(--color-surface-2);
  }
  .footer-grid {
    display: grid;
    gap: 2rem;
  }
  .footer-logo {
    width: 190px;
    height: auto;
  }
  .footer-tagline {
    font-size: 0.85rem;
    max-width: 28ch;
    margin-top: 0.75rem;
  }
  .footer-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  address {
    font-style: normal;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--color-surface-2);
    font-size: 0.72rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
</style>
