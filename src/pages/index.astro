---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const links = ['Contacto', 'Dónde encontrarnos', 'Redes sociales'];
---

<BaseLayout
  title={site.brand.name}
  description="Bienvenido a Azul Marino Zapatería. Pronto compartiremos más información sobre nuestra tienda."
  path="/"
  activePath="/"
>
  <main id="main" class="hola">
    <div class="hola__inner">
      <header class="hola__header">
        <p class="hola__label">Bienvenido a</p>
        <h1>{site.brand.name}</h1>
      </header>

      <section class="hola__intro" aria-label="Presentación">
        <p>Estamos preparando nuestra nueva web.</p>
        <p>Pronto encontrarás aquí más información sobre nuestra zapatería.</p>
      </section>

      <nav class="hola__links" aria-label="Próximos enlaces">
        <ul role="list" class="hola__link-list">
          {links.map((label) => (
            <li>
              <span class="hola__link" role="link" aria-disabled="true">
                <span>{label}</span>
                <span class="hola__soon-badge">Próximamente</span>
              </span>
            </li>
          ))}
        </ul>
      </nav>

      <footer class="hola__footer">
        <p>{site.brand.name}</p>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  /* Retain /hola/'s narrow, centered stack and link rows with shared tokens. */
  .hola {
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding: var(--space-lg) var(--space-md) var(--space-md);
    background-color: var(--color-bg);
  }
  .hola__inner {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }
  .hola__header { padding-block-end: var(--space-3xs); }
  .hola__label {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2xs);
  }
  h1 {
    font-family: var(--font-title);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    margin: 0;
  }
  .hola__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .hola__intro p { max-width: 36ch; margin: 0; }
  .hola__links { width: 100%; }
  .hola__link-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-surface-2);
  }
  .hola__link-list li { border-bottom: 1px solid var(--color-surface-2); }
  .hola__link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    min-height: var(--touch-min);
    padding: var(--space-xs) var(--space-sm);
    text-align: start;
    color: var(--color-text-secondary);
  }
  .hola__soon-badge {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: var(--color-surface-2);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .hola__footer {
    margin-block-start: var(--space-sm);
    padding-block-start: var(--space-sm);
    border-top: 1px solid var(--color-surface-2);
    width: 100%;
  }
  .hola__footer p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: none;
  }
  @media (min-width: 600px) {
    .hola { padding-block-start: var(--space-xl); }
    .hola__inner { gap: var(--space-lg); }
  }
</style>
