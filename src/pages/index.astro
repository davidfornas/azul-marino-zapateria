---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { logo } from '../config/artwork';
import { whatsappUrl } from '../lib/whatsapp';

const links = [
  { label: 'Escríbenos por WhatsApp', href: whatsappUrl()!, primary: true, external: true },
  { label: 'Síguenos en Instagram', href: site.instagram.profileUrl, external: true },
  { label: 'Cómo llegar', href: site.contact.mapsUrl, external: true },
  { label: `Llámanos · ${site.contact.phoneLabel}`, href: `tel:${site.contact.phone}`, external: false },
];
---

<BaseLayout
  title={site.brand.name}
  description="Azul Marino Zapatería en Castellón de la Plana. Más de 30 años de calidad, confianza y estilo. Visítanos en Calle Maestro Ripollés, 16."
  path="/"
  activePath="/"
>
  <main id="main" class="hola">
    <div class="hola__inner">
      <header class="hola__header">
        <h1 class="visually-hidden">{site.brand.name}</h1>
        <Image src={logo} alt={site.brand.name} class="hola__logo" loading="eager" fetchpriority="high" />
        <p class="hola__slogan">{site.brand.tagline}</p>
      </header>

      <nav class="hola__links" aria-label="Contacta y visítanos">
        <ul role="list" class="hola__link-list">
          {links.map(({ label, href, primary, external }) => (
            <li>
              <a href={href} class:list={['hola__link', { 'hola__link--primary': primary }]}
                target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                <span>{label}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path d={external ? 'M7 17 17 7M7 7h10v10' : 'M4 12h16m-6-6 6 6-6 6'} />
                </svg>
                {external && <span class="visually-hidden"> (se abre en otra pestaña)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a class="hola__reel" href={site.presentationUrl} target="_blank" rel="noopener noreferrer">
        Conócenos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M7 17 17 7M7 7h10v10" /></svg>
        <span class="visually-hidden"> (se abre en otra pestaña)</span>
      </a>

      <footer class="hola__footer">
        <address>{site.contact.address}<br />{site.contact.postalAddress}</address>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  /* Preserve /hola/'s compact, centered stack using shared design tokens. */
  .hola {
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding: var(--space-lg) var(--space-md) var(--space-md);
    background: var(--color-bg);
  }
  .hola__inner {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }
  .hola__header { width: 100%; }
  h1 { font-size: 1.75rem; margin: 0 0 var(--space-md); }
  .hola__logo { width: min(100%, 320px); height: auto; margin-inline: auto; }
  .hola__slogan {
    margin: var(--space-sm) auto 0;
    max-width: 31ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: balance;
  }
  .hola__links { width: 100%; }
  .hola__link-list { display: flex; flex-direction: column; gap: var(--space-xs); }
  .hola__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-height: 56px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    color: var(--color-accent);
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: start;
    text-decoration: none;
  }
  .hola__link svg { flex-shrink: 0; }
  .hola__link--primary { background: var(--color-accent); color: var(--color-bg); }
  .hola__link:hover { background: var(--color-surface-2); color: var(--color-accent); }
  .hola__link--primary:hover { background: var(--color-accent-strong); color: var(--color-bg); }
  .hola__reel {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--touch-min);
    padding-inline: var(--space-xs);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }
  .hola__footer {
    width: 100%;
    border-top: 1px solid var(--color-surface-2);
    padding-block: var(--space-md);
  }
  address { font-style: normal; font-size: 0.8125rem; line-height: 1.7; color: var(--color-text); }
  @media (min-width: 600px) { .hola { padding-block-start: var(--space-xl); } }
</style>
