---
import PageLayout from '../layouts/PageLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CollectionGrid from '../components/CollectionGrid.astro';
import ShopExterior from '../components/ShopExterior.astro';
import { withBase } from '../lib/url';
import { whatsappUrl } from '../lib/whatsapp';
import { site } from '../config/site';
---

<PageLayout
  title="Azul Marino Zapatería · Calzado en Castellón"
  description="Tu zapatería en Castellón de la Plana. Más de 30 años de calidad, confianza y estilo. Descubre Azul Marino y ven a vernos en Maestro Ripollés, 16."
  path="/"
  activePath="/"
>
  <section class="hero container">
    <div class="hero__copy">
      <p class="eyebrow">Azul Marino · Castellón</p><h1 class="editorial-title">
        Cada paso,<br /><em>un poco de ti.</em>
      </h1><p class="lede">
        Hay formas de vestir que hablan de ti.<br />Y un buen paso por el que
        empezar.
      </p><a class="button" href={withBase('/colecciones/')}
        >Explora las colecciones <span aria-hidden="true">&nbsp; →</span></a
      ><p class="hero__signature">{site.brand.tagline}</p>
    </div>
    <figure class="hero__visual">
      <img
        src={withBase('/images/placeholders/calzado-cotidiano.svg')}
        width="800"
        height="1000"
        alt="Composición editorial abstracta de ejemplo; fotografía de calzado pendiente."
        loading="eager"
        fetchpriority="high"
      /><figcaption>
        Imagen provisional · fotografía de calzado pendiente
      </figcaption>
    </figure>
  </section>
  <section class="intro boutique-section">
    <div class="container intro__inner">
      <p class="eyebrow">Cerca de ti. Con estilo propio.</p><h2>
        Una zapatería de aquí.<br /><em>Una forma muy tuya de caminar.</em>
      </h2><p>
        Somos Azul Marino Zapatería, en Castellón de la Plana. Un lugar al que
        venir, mirar con calma y encontrar tu próximo paso. Nos encantará
        conocerte en nuestra tienda de Maestro Ripollés.
      </p><a class="text-link" href={withBase('/nuestra-tienda/')}
        >Conoce nuestra tienda <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="boutique-section">
    <div class="container">
      <div class="section-heading">
        <SectionTitle eyebrow="Un primer vistazo"
          >Distintas formas de ir contigo.</SectionTitle
        ><a class="text-link" href={withBase('/colecciones/')}
          >Ver las colecciones <span aria-hidden="true">→</span></a>
      </div><CollectionGrid /><p class="provisional-note collection-note">
        Categorías e imágenes de ejemplo. Estamos preparando las colecciones
        reales; estas propuestas no indican productos disponibles.
      </p>
    </div>
  </section>
  <section class="boutique-section shop-section">
    <div class="container split">
      <ShopExterior /><div class="section-copy">
        <SectionTitle eyebrow="Nos vemos en Castellón"
          >El mejor encuentro<br />es en la tienda.</SectionTitle
        ><p class="lede">
          Algunas cosas se disfrutan más de cerca. Pásate por Azul Marino y
          descubre nuestra zapatería a tu ritmo.
        </p><p>{site.contact.address}<br />{site.contact.postalAddress}</p><a
          class="text-link"
          href={withBase('/nuestra-tienda/')}
          >Nuestra tienda y contacto <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="boutique-section">
    <div class="container visit">
      <p class="eyebrow">Damos el siguiente paso</p><h2>
        ¿Vienes a conocernos?
      </h2><p>
        Te esperamos en Maestro Ripollés, 16.<br />Si prefieres escribirnos
        antes, estamos al otro lado.
      </p><div class="button-row">
        <a
          class="button"
          href={site.contact.mapsUrl}
          target="_blank"
          rel="noopener noreferrer">Cómo llegar</a
        ><a
          class="button button--outline"
          href={whatsappUrl()!}
          target="_blank"
          rel="noopener noreferrer">Hablemos por WhatsApp</a>
      </div>
    </div>
  </section>
</PageLayout>
<style>
  .hero {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .hero__copy em {
    font-weight: 400;
  }
  .hero__signature {
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }
  .hero__visual {
    margin: 0;
  }
  .hero__visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .hero__visual figcaption {
    font-size: 0.65rem;
    margin-top: 0.5rem;
  }
  .intro {
    border-block: 1px solid var(--color-surface-2);
  }
  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .intro h2 {
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.3rem);
  }
  .intro p:not(.eyebrow) {
    max-width: 57ch;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .collection-note {
    margin-top: 2rem;
  }
  .shop-section {
    background: #f5e8dc;
  }
  .visit {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }
  .visit h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
  }
  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
      padding-block: 3.5rem;
    }
    .hero__visual {
      max-height: 640px;
    }
    .hero__visual img {
      max-height: 600px;
    }
  }
</style>
